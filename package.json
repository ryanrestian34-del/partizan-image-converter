{
  "name": "partizan-image-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Partizan Face Image Converter",
  "author": "Ryan",
  "main": "electron.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "npx electron electron.cjs",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron\"",
    "dist": "electron-builder"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "next": "^16.2.6",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.partizan.imageconverter",
    "productName": "Partizan Image Converter",
    "artifactName": "Partizan-Image-Converter-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
